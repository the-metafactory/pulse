# Mattermost notification config for A_NOTIFY_MATTERMOST.
# Copy to .env (gitignored) and fill in real values — never commit secrets.
#
# Sage bot on the SWITCH cortex stack: values live in
# ~/.config/cortex/switch/stacks/switch.yaml under agents[sage].presence.mattermost
MATTERMOST_URL=https://mattermost.example.ch
MATTERMOST_BOT_TOKEN=your-bot-token-here
MATTERMOST_CHANNEL_ID=your-channel-id-here
